        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Sum ai.proxy.usage.total_tokens",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "aigw_team.keyword": "consumer group",
              "aigw_user.keyword": "employee",
              "Sum ai.proxy.usage.total_tokens": "tokens",
              "Sum ai.proxy.usage.cost": "cost ($)",
              "Count": "requests"
            }
          }
        }
      ]
    },
