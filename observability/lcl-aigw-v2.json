      "type": "row",
      "title": "Usage by consumer group \u2014 request logs (aigw_team = ADFS group)",
      "id": 5,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 52
