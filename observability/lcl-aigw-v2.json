            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "aigw_team.keyword",
              "settings": {
                "size": "20",
                "order": "desc",
                "orderBy": "1",
                "min_doc_count": "1"
