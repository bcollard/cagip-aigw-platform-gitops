{
  "title": "Kong AI Gateway v2 \u2014 usage by entity, group and employee",
  "uid": "lcl-aigw-v2",
  "tags": [
    "kong",
    "ai-gateway",
    "llm"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "entity",
        "label": "Entity (BU)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kong_ai_llm_requests_total, entity)",
          "refId": "entity"
        },
        "definition": "label_values(kong_ai_llm_requests_total, entity)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "provider",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "includeAll": true,
        "multi": true,
        "query": "label_values(kong_ai_llm_requests_total, ai_provider)",
        "refresh": 2
      },
      {
        "name": "model",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "includeAll": true,
        "multi": true,
        "query": "label_values(kong_ai_llm_requests_total, ai_model)",
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Traffic",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "LLM requests/s by provider",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "legendFormat": "{{ai_provider}}",
          "expr": "sum by (ai_provider) (rate(kong_ai_llm_requests_total{ai_provider=~\"$provider\",ai_model=~\"$model\",entity=~\"$entity\"}[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM requests/s by model",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "legendFormat": "{{ai_provider}}/{{ai_model}}",
          "expr": "sum by (ai_provider,ai_model) (rate(kong_ai_llm_requests_total{ai_provider=~\"$provider\",ai_model=~\"$model\",entity=~\"$entity\"}[5m]))"
        }
      ]
    },
    {
      "type": "row",
      "title": "Tokens",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Tokens/s by type",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "legendFormat": "{{token_type}}",
          "expr": "sum by (token_type) (rate(kong_ai_llm_tokens_total{ai_provider=~\"$provider\",ai_model=~\"$model\",entity=~\"$entity\"}[5m]))"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Total tokens by model (share of spend proxy)",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "legendFormat": "{{ai_provider}}/{{ai_model}}",
          "expr": "sum by (ai_provider,ai_model) (kong_ai_llm_tokens_total{token_type=\"total_tokens\",ai_provider=~\"$provider\",ai_model=~\"$model\",entity=~\"$entity\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total tokens (range)",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum(increase(kong_ai_llm_tokens_total{token_type=\"total_tokens\",ai_provider=~\"$provider\",ai_model=~\"$model\",entity=~\"$entity\"}[$__range]))"
        }
      ]
    },
    {
      "type": "row",
      "title": "Cost",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "type": "timeseries",
      "title": "Spend rate ($/hour) by model",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "description": "Requires input_cost/output_cost (dollars per 1M tokens) on the AI target. Kong computes cost = (prompt*input_cost + completion*output_cost)/1e6.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "legendFormat": "{{ai_provider}}/{{ai_model}}",
          "expr": "sum by (ai_provider,ai_model) (rate(kong_ai_llm_cost_total{ai_provider=~\"$provider\",ai_model=~\"$model\",entity=~\"$entity\"}[5m])) * 3600"
        }
      ]
    },
    {
      "type": "piechart",
      "title": "Cost share by model",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 5
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "legendFormat": "{{ai_provider}}/{{ai_model}}",
          "expr": "sum by (ai_provider,ai_model) (increase(kong_ai_llm_cost_total{ai_provider=~\"$provider\",ai_model=~\"$model\",entity=~\"$entity\"}[$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total spend (range)",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 5
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "expr": "sum(increase(kong_ai_llm_cost_total{ai_provider=~\"$provider\",ai_model=~\"$model\",entity=~\"$entity\"}[$__range]))"
        }
      ]
    },
    {
      "type": "row",
      "title": "Latency",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      }
    },
    {
      "comment": "The AI latency histograms are ms-valued. Use _sum/_count for a mean rather than histogram_quantile, whose buckets are coarse (1s..60s) and blind below 1s.",
      "type": "timeseries",
      "title": "Mean provider latency (ms) \u2014 _sum/_count",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "legendFormat": "{{ai_provider}}/{{ai_model}}",
          "expr": "sum by (ai_provider,ai_model) (rate(kong_ai_llm_provider_latency_ms_sum{ai_provider=~\"$provider\",ai_model=~\"$model\",entity=~\"$entity\"}[5m])) / sum by (ai_provider,ai_model) (rate(kong_ai_llm_provider_latency_ms_count{ai_provider=~\"$provider\",ai_model=~\"$model\",entity=~\"$entity\"}[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Mean time to first token (ms)",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "legendFormat": "{{ai_provider}}/{{ai_model}}",
          "expr": "sum by (ai_provider,ai_model) (rate(kong_ai_llm_ttft_latency_ms_sum{ai_provider=~\"$provider\",ai_model=~\"$model\",entity=~\"$entity\"}[5m])) / sum by (ai_provider,ai_model) (rate(kong_ai_llm_ttft_latency_ms_count{ai_provider=~\"$provider\",ai_model=~\"$model\",entity=~\"$entity\"}[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Mean time per output token (ms)",
      "datasource": "Prometheus",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": "Prometheus",
          "legendFormat": "{{ai_provider}}/{{ai_model}}",
          "expr": "sum by (ai_provider,ai_model) (rate(kong_ai_llm_tpot_latency_ms_sum{ai_provider=~\"$provider\",ai_model=~\"$model\",entity=~\"$entity\"}[5m])) / sum by (ai_provider,ai_model) (rate(kong_ai_llm_tpot_latency_ms_count{ai_provider=~\"$provider\",ai_model=~\"$model\",entity=~\"$entity\"}[5m]))"
        }
      ]
    },
