    },
    {
      "type": "barchart",
      "title": "Tokens by consumer group",
      "id": 6,
      "datasource": {
        "type": "elasticsearch",
        "uid": "es-kong-ai"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 53
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "es-kong-ai"
          },
          "query": "aigw_entity:${entity:lucene} AND _exists_:ai.proxy.usage",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "sum",
              "field": "ai.proxy.usage.total_tokens"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "aigw_team.keyword",
              "settings": {
                "size": "10",
                "order": "desc",
                "orderBy": "1",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "aigw_team.keyword",
        "showValue": "auto",
        "legend": {
          "showLegend": false
        }
      }
    },
